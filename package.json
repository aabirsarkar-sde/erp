{
  "name": "raybon-erp",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "node tests/e2e/crm-and-access.e2e.mjs && node tests/e2e/helpdesk.e2e.mjs && node tests/e2e/crm-workflow.e2e.mjs && node tests/e2e/crm-engage.e2e.mjs && node tests/e2e/crm-structure.e2e.mjs",
    "test:odoo": "node tests/integration/odoo-import.test.mjs",
    "odoo:import": "tsx scripts/odoo-import.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts --force",
    "db:studio": "drizzle-kit studio",
    "setup": "drizzle-kit push --force && tsx scripts/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "next": "^16.3.8",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
