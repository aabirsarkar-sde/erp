# Which product this deployment is: "crm" (Raybon Sales CRM), "helpdesk" (Raybon O&M Helpdesk),
# or leave empty to run both together (handy for local development).
APP_EDITION=""

# Local: a SQLite file. Production (free): create a Turso DB and paste its URL + token here.
DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- Email (optional; without SMTP_HOST emails are printed to the console) ---
APP_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Raybon Support <support@example.com>"
SUPPORT_EMAIL=""
INBOUND_EMAIL_SECRET="change-me-inbound-secret"

# --- AI (optional). Free option: Google AI Studio key → https://aistudio.google.com/apikey ---
# Works with any OpenAI-compatible API (Gemini, Groq, OpenRouter, Ollama…). AI_PROVIDER="mock" shows demo answers until a key is added (a key always wins).
AI_API_KEY=""
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
AI_MODEL="gemini-flash-latest"
AI_PROVIDER="mock"

# Scheduled jobs (Vercel Cron) + Microsoft 365 webhook. Any long random string.
CRON_SECRET=""

# --- Microsoft 365 (optional, recommended for raybonchemicals.com): send + receive email via Graph, no SMTP password ---
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_SEND_FROM=""        # e.g. crm@raybonchemicals.com
MS_INBOX=""            # mailbox(es) to read: sales@… for the CRM, support@… for the helpdesk

# Website enquiry API (optional): require header x-enquiry-key
ENQUIRY_API_KEY=""
